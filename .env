# Camera indexes (/dev/videoN). They can change when a camera is re-plugged:
# check with  v4l2-ctl --list-devices  or ../cam_view.py
TOP_CAM=4
WRIST_CAM=6
BASE_CAM=2
TOP_RES=1920x1080      # camera modes the calibrations were measured in (top / base are then cropped to 4:3 = 1440x1080)
WRIST_RES=640x480      # change one only together with a new calibration of that camera
BASE_RES=1920x1080
CAM_FOURCC=MJPG        # MJPG = fast (~11 fps at 1920x1080); YUYV = raw (~1 fps at 1920x1080); same picture
CAM_FPS=30             # frame rate asked from the cameras (they give what their mode allows: measured ~11-18 fps)
REC_FPS=10             # frames per second written by click_goal_real.py --record
ARM_PORT=/dev/ttyACM1  # the arm's USB serial port (can become /dev/ttyACM1 after a re-plug: ls /dev/ttyACM*)
## deafult gripper range min ,  max
# GRIPPER_MIN=2          # gripper range allowed by arm_server (0 = closed end .. 100 = open end); every command is clamped
# GRIPPER_MAX=98

GRIPPER_MIN=40        
GRIPPER_MAX=88


